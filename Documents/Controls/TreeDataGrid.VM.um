        ),

        FileNodeModel.CreateFile("安装说明.txt", "文本文档", "1 KB"),
        FileNodeModel.CreateFile("许可证.pdf", "PDF 文档", "256 KB")
    };
}

#endregion

#region Commands

[RelayCommand]
private void ExpandAll()
{
    SelectedExpandLevel = -1;
}

[RelayCommand]
private void CollapseAll()
{
    SelectedExpandLevel = 0;
}

[RelayCommand]
private void AddFile()
{
    var newFile = FileNodeModel.CreateFile(
        $"新文件_{DateTime.Now:HHmmss}.txt",
        "文本文档",
        "0 KB"
    );
    FileTreeData.Add(newFile);
}

[RelayCommand]
private void AddFolder()
{
    var newFolder = FileNodeModel.CreateFolder($"新文件夹_{DateTime.Now:HHmmss}");
    FileTreeData.Add(newFolder);
}

[RelayCommand]
private void RefreshData()
{
    InitializeData();
}

[RelayCommand]
private void View(TreeDataGridItem item)
{
    if (item?.DataItem is FileNodeModel fileNode)
    {
        AduMessageBox.Show($"查看: {fileNode.Name}\n类型: {fileNode.Type}\n大小: {fileNode.Size}", "查看详情");
    }
}

[RelayCommand]
private void Edit(TreeDataGridItem item)
{
    if (item?.DataItem is FileNodeModel fileNode)
    {
        AduMessageBox.Show($"编辑: {fileNode.Name}\n\n这里可以实现编辑功能", "编辑");
    }
}

[RelayCommand]
private void Delete(TreeDataGridItem item)
{
    if (item?.DataItem is FileNodeModel fileNode)
    {
        var result = AduMessageBox.Show(
            $"确定要删除 '{fileNode.Name}' 吗？",
            "确认删除",
            MessageBoxButton.YesNo);

        if (result == MessageBoxResult.Yes)
        {
            // 从父节点中移除
            if (RemoveNode(FileTreeData, fileNode))
            {
                // 触发刷新
                var temp = FileTreeData;
                FileTreeData = null;
                FileTreeData = temp;
            }
        }
    }
}

/// <summary>
/// 递归删除节点
/// </summary>
private bool RemoveNode(ObservableCollection<FileNodeModel> nodes, FileNodeModel target)
{
    if (nodes.Remove(target))
        return true;

    foreach (var node in nodes)
    {
        if (RemoveNode(node.Children, target))
            return true;
    }

    return false;
}

#endregion