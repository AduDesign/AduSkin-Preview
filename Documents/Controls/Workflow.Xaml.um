<!--  Example 1: Basic workflow editor  -->
<Border
	Height="640"
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<wf:WorkflowEditor
		x:Name="WorkflowCanvas"
		Graph="{Binding Graph, Mode=TwoWay}"
		Options="{Binding Options}" />
</Border>

<!--  Example 2: Configure designer options in XAML  -->
<Border
	Height="520"
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<wf:WorkflowEditor Graph="{Binding PreviewGraph, Mode=TwoWay}">
		<wf:WorkflowEditor.Options>
			<wf:WorkflowDesignerOptions
				IsNodePanelPinned="False"
				IsPropertyPanelPinned="False"
				ShowGrid="True"
				ShowMiniMap="True"
				SnapToGrid="True" />
		</wf:WorkflowEditor.Options>
	</wf:WorkflowEditor>
</Border>

<!--  Example 3: Dynamically load shipped workflow files  -->
<Border
	Height="680"
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Margin="10" Orientation="Horizontal">
			<AduSkin:AduFormBox Header="示例">
				<AduSkin:AduComboBox
					Width="260"
					DisplayMemberPath="Name"
					ItemsSource="{Binding Samples}"
					SelectedItem="{Binding SelectedSample, Mode=TwoWay}" />
			</AduSkin:AduFormBox>
			<AduSkin:AduButton
				Margin="8,0,0,0"
				Command="{Binding LoadSampleCommand}"
				Content="加载示例" />
			<TextBlock
				Margin="12,0,0,0"
				VerticalAlignment="Center"
				Text="{Binding SampleStatus}" />
		</StackPanel>

		<wf:WorkflowEditor
			x:Name="SampleWorkflowCanvas"
			Grid.Row="1"
			Graph="{Binding Graph, Mode=TwoWay}"
			Options="{Binding Options}" />
	</Grid>
</Border>

<!--
Required namespaces:
xmlns:AduSkin="clr-namespace:AduSkin.Controls;assembly=AduSkin"
xmlns:wf="clr-namespace:AduSkin.Extensions.Workflow;assembly=Workflow"
-->
