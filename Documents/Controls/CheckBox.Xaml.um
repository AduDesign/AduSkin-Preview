<!--  Example 1: Basic States  -->
<Border
    Margin="0,0,0,20"
    BorderThickness="1"
    CornerRadius="8">
    <StackPanel>
        <TextBlock
            Margin="0,0,0,15"
            FontSize="18"
            FontWeight="SemiBold"
            Text="Example 1: Basic States" />

        <TextBlock
            Margin="0,0,0,15"
            FontSize="12"
            Text="Unchecked, checked, and indeterminate states"
            TextWrapping="Wrap" />

        <UniformGrid
            HorizontalAlignment="Left"
            Columns="3"
            Rows="1">
            <AduSkin:AduCheckBox
                Margin="4"
                Content="Unchecked"
                IsChecked="False" />
            <AduSkin:AduCheckBox
                Margin="4"
                Content="Checked"
                IsChecked="True" />
            <AduSkin:AduCheckBox
                Margin="4"
                Content="Indeterminate"
                IsChecked="{x:Null}" />
        </UniformGrid>
    </StackPanel>
</Border>

<!--  Example 2: Disabled State  -->
<Border
    Margin="0,0,0,20"
    BorderThickness="1"
    CornerRadius="8">
    <StackPanel>
        <TextBlock
            Margin="0,0,0,15"
            FontSize="18"
            FontWeight="SemiBold"
            Text="Example 2: Disabled State" />

        <TextBlock
            Margin="0,0,0,15"
            FontSize="12"
            Text="Disabled checkboxes in different states"
            TextWrapping="Wrap" />

        <UniformGrid HorizontalAlignment="Left" Columns="3">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <AduSkin:AduCheckBox
                    Margin="4"
                    Content="Disabled"
                    IsChecked="False"
                    IsEnabled="False" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <AduSkin:AduCheckBox
                    Margin="4"
                    Content="Disabled"
                    IsChecked="True"
                    IsEnabled="False" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <AduSkin:AduCheckBox
                    Margin="4"
                    Content="Disabled"
                    IsChecked="{x:Null}"
                    IsEnabled="False" />
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</Border>