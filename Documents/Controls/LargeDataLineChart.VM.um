private Random random = new Random();
public LargeDataLineChartViewModel()
{
    GenerateSampleData();
}
[RelayCommand]
void Generate()
{
    GenerateSampleData();
}
[RelayCommand]
void Clear()
{
    ItemsSource?.Clear();
}

private void GenerateSampleData()
{
    Clear();
    var temp = new ObservableCollection<Point>();
    for (int i = 0; i < MaxCount; i++)
    {
        temp.Add(new Point(i, random.Next(10, 100)));
    }
    ItemsSource = temp;
}
[ObservableProperty]
private ObservableCollection<Point> _itemsSource;

[ObservableProperty]
private int _maxCount = 100000;

[ObservableProperty]
private int _maxDisplayCount = 3000;

[ObservableProperty]
private bool _isDrawingGrid = false;

[ObservableProperty]
private bool _isDragEnable = true;

[ObservableProperty]
private bool _isZoomEnable = true;