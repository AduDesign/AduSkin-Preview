<Grid>
	<Grid.RowDefinitions>
		<RowDefinition Height="Auto" />
		<RowDefinition Height="*" />
	</Grid.RowDefinitions>

	<StackPanel Margin="0,10" Orientation="Horizontal">
		<AduSkin:AduButton Command="{Binding GenerateCommand}" Content="生成随机数据" />
		<AduSkin:AduButton
			Margin="10,0"
			Command="{Binding ClearCommand}"
			Content="清除数据" />
		<AduSkin:AduCheckBox Content="IsDrawingGrid" IsChecked="{Binding IsDrawingGrid}" />
		<AduSkin:AduCheckBox
			Margin="10,0"
			Content="IsDrawingAxes"
			IsChecked="{Binding IsDrawingAxes}" />
		<AduSkin:AduCheckBox Content="IsDrawingLegend" IsChecked="{Binding IsDrawingLegend}" />
	</StackPanel>

	<AduSkin:AduRadar
		Grid.Row="1"
		Height="400"
		AduAttach:HeaderAttach.FontSize="14"
		AduAttach:HeaderAttach.Foreground="{DynamicResource PrimaryBrush}"
		AduAttach:HeaderAttach.Header="Radar Chart"
		AduAttach:HeaderAttach.Margin="0,0,0,0"
		AxisLabels="{Binding Labels}"
		Background="Transparent"
		FontSize="14"
		Foreground="{DynamicResource PrimaryBrush}"
		Series="{Binding ItemsSource}" />
</Grid>