<!--  Example 1: Basic Usage  -->
<Border
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<StackPanel>
		<TextBlock
			Margin="0,0,0,15"
			FontSize="18"
			FontWeight="SemiBold"
			Text="Example 1: Basic Usage" />

		<TextBlock
			Margin="0,0,0,15"
			FontSize="12"
			Text="Image avatars, fallback text, and command-enabled avatars"
			TextWrapping="Wrap" />

		<WrapPanel>
			<AduSkin:AduAvatar
				Margin="4,4,12,4"
				AduAttach:BorderAttach.CornerRadius="10"
				BorderThickness="3"
				Command="{Binding AvatarCommand}"
				Cursor="Hand"
				FallbackMemberPath="Name"
				FallbackText="AD"
				ImageMemberPath="Image"
				Item="{Binding Avatars[0]}" />
			<AduSkin:AduAvatar
				Width="48"
				Height="48"
				Margin="4,4,12,4"
				BorderThickness="1"
				Command="{Binding AvatarCommand}"
				Cursor="Hand"
				FallbackMemberPath="Name"
				FallbackText="SK"
				ImageMemberPath="Image"
				Item="{Binding Avatars[1]}" />
			<AduSkin:AduAvatar
				Width="56"
				Height="56"
				Margin="4,4,12,4"
				BorderThickness="1"
				Command="{Binding AvatarCommand}"
				Cursor="Hand"
				FallbackMemberPath="Name"
				FallbackText="NA"
				ImageMemberPath="Image"
				Item="{Binding MissingAvatar}" />
			<AduSkin:AduAvatar
				Width="40"
				Height="40"
				Margin="4,4,12,4"
				FallbackText="JW" />
		</WrapPanel>
	</StackPanel>
</Border>

<!--  Example 2: Sizes  -->
<Border
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<StackPanel>
		<TextBlock
			Margin="0,0,0,15"
			FontSize="18"
			FontWeight="SemiBold"
			Text="Example 2: Sizes" />

		<TextBlock
			Margin="0,0,0,15"
			FontSize="12"
			Text="Avatar controls can be sized directly with Width and Height"
			TextWrapping="Wrap" />

		<WrapPanel VerticalAlignment="Center">
			<AduSkin:AduAvatar
				Width="32"
				Height="32"
				Margin="4,4,12,4"
				FallbackMemberPath="Name"
				FallbackText="S"
				ImageMemberPath="Image"
				Item="{Binding Avatars[2]}" />
			<AduSkin:AduAvatar
				Width="40"
				Height="40"
				Margin="4,4,12,4"
				FallbackMemberPath="Name"
				FallbackText="M"
				ImageMemberPath="Image"
				Item="{Binding Avatars[3]}" />
			<AduSkin:AduAvatar
				Width="48"
				Height="48"
				Margin="4,4,12,4"
				FallbackMemberPath="Name"
				FallbackText="L"
				ImageMemberPath="Image"
				Item="{Binding Avatars[4]}" />
			<AduSkin:AduAvatar
				Width="64"
				Height="64"
				Margin="4,4,12,4"
				FallbackMemberPath="Name"
				FallbackText="XL"
				ImageMemberPath="Image"
				Item="{Binding Avatars[5]}" />
		</WrapPanel>
	</StackPanel>
</Border>

<!--  Example 3: Avatar Group  -->
<Border
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<StackPanel>
		<TextBlock
			Margin="0,0,0,15"
			FontSize="18"
			FontWeight="SemiBold"
			Text="Example 3: Avatar Group" />

		<TextBlock
			Margin="0,0,0,15"
			FontSize="12"
			Text="Grouped avatars overlap each other and show the remaining count"
			TextWrapping="Wrap" />

		<AduSkin:AduAvatarGroup
			AvatarSize="30"
			FallbackMemberPath="Name"
			ImageMemberPath="Image"
			ItemCommand="{Binding AvatarCommand}"
			ItemsSource="{Binding GroupAvatars}"
			MaxVisibleCount="5"
			Overlap="14" />
	</StackPanel>
</Border>

<!--  Example 4: Object Binding List  -->
<Border
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<StackPanel>
		<TextBlock
			Margin="0,0,0,15"
			FontSize="18"
			FontWeight="SemiBold"
			Text="Example 4: Object Binding List" />

		<TextBlock
			Margin="0,0,0,15"
			FontSize="12"
			Text="Each avatar binds to an object and reads the image from ImageMemberPath"
			TextWrapping="Wrap" />

		<ItemsControl ItemsSource="{Binding Avatars}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<AduSkin:AduAvatar
						Width="44"
						Height="44"
						Margin="4,4,12,4"
						FallbackMemberPath="Name"
						ImageMemberPath="Image"
						Item="{Binding}" />
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</StackPanel>
</Border>