    get => _hexCode;
    set => SetProperty(ref _hexCode, value);
}

private string _verticalCode = string.Empty;
public string VerticalCode
{
    get => _verticalCode;
    set => SetProperty(ref _verticalCode, value);
}

private string _verificationCode = string.Empty;
public string VerificationCode
{
    get => _verificationCode;
    set
    {
        string newValue = value ?? string.Empty;
        if (SetProperty(ref _verificationCode, newValue) && newValue.Length < 6)
        {
            VerificationResult = "Waiting for complete input...";
        }
    }
}

private string _verificationResult = "Waiting for complete input...";
public string VerificationResult
{
    get => _verificationResult;
    set => SetProperty(ref _verificationResult, value);
}

[RelayCommand]
private void VerifyCaptcha(string? code)
{
    VerificationResult = string.Equals(code, "A2B4C6", StringComparison.Ordinal)
        ? "Verification passed."
        : $"Verification failed. Input: {code}";
    AduMessageBox.Show(VerificationResult);
}