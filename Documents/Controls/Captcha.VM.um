private string _basicCode = string.Empty;
public string BasicCode
{
    get => _basicCode;
    set => SetProperty(ref _basicCode, value);
}

private string _numberCode = string.Empty;
public string NumberCode
{
    get => _numberCode;
    set => SetProperty(ref _numberCode, value);
}

private string _letterCode = string.Empty;
public string LetterCode
{
    get => _letterCode;
    set => SetProperty(ref _letterCode, value);
}

private string _mixedCode = string.Empty;
public string MixedCode
{
    get => _mixedCode;
    set => SetProperty(ref _mixedCode, value);
}

private string _passwordCode = string.Empty;
public string PasswordCode
{
    get => _passwordCode;
    set => SetProperty(ref _passwordCode, value);
}

private string _hexCode = string.Empty;
public string HexCode
