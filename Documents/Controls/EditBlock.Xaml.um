            <Border Margin="0,0,0,20" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,15" FontSize="18" FontWeight="SemiBold" Text="Example 1: Editable Text" />
                    <TextBlock Margin="0,0,0,15" FontSize="12" Text="双击文本开始编辑；Enter 提交，Esc 结束编辑。" TextWrapping="Wrap" />
                    <StackPanel Margin="5,0,0,10" HorizontalAlignment="Left">
                        <AduSkin:AduEditableTextBlock Width="240" Text="{Binding Name2, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding Name2, StringFormat=当前值：{0}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,20" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,15" FontSize="18" FontWeight="SemiBold" Text="Example 2: Editable ComboBox" />
                    <TextBlock Margin="0,0,0,15" FontSize="12" Text="单击选择状态，关闭下拉框后恢复文本；支持筛选。" TextWrapping="Wrap" />
                    <StackPanel Margin="5,0,0,10" HorizontalAlignment="Left">
                        <AduSkin:AduEditableComboBox Width="240" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" IsShowFilterBox="True" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding SelectedStatus, StringFormat=当前值：{0}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,20" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,15" FontSize="18" FontWeight="SemiBold" Text="Example 3: Editable IntegerUpDown" />
                    <TextBlock Margin="0,0,0,15" FontSize="12" Text="单击编辑数量，范围 0–100；Enter 或失焦结束编辑。" TextWrapping="Wrap" />
                    <StackPanel Margin="5,0,0,10" HorizontalAlignment="Left">
                        <AduSkin:AduEditableIntegerUpDown Width="240" Minimum="0" Maximum="100" Increment="1" Value="{Binding Quantity, Mode=TwoWay}" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding Quantity, StringFormat=当前值：{0}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,20" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,15" FontSize="18" FontWeight="SemiBold" Text="Example 4: Editable DoubleUpDown" />
                    <TextBlock Margin="0,0,0,15" FontSize="12" Text="单击编辑数值，步进 0.1，保留两位小数。" TextWrapping="Wrap" />
                    <StackPanel Margin="5,0,0,10" HorizontalAlignment="Left">
                        <AduSkin:AduEditableDoubleUpDown Width="240" Minimum="0" Maximum="1000" Increment="0.1" DecimalPlaces="2" Value="{Binding Amount, Mode=TwoWay}" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding Amount, StringFormat=当前值：{0}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,20" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Margin="0,0,0,15" FontSize="18" FontWeight="SemiBold" Text="Example 5: Editable DatePicker" />
                    <TextBlock Margin="0,0,0,15" FontSize="12" Text="单击打开日历，选择日期或关闭日历后恢复文本。" TextWrapping="Wrap" />
                    <StackPanel Margin="5,0,0,10" HorizontalAlignment="Left">
                        <AduSkin:AduEditableDatePicker Width="240" DateStringFormat="yyyy-MM-dd" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Text="{Binding SelectedDate, StringFormat=当前值：{0}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
