#region 示例 3 选择单行/多行/双击命令
/// <summary>
/// 示例 3 基础数据源，包含单选和多选属性
/// </summary>
[ObservableProperty]
private ObservableCollection<TempModel> _itemsSource = new ObservableCollection<TempModel>();

/// <summary>
/// 当前选中项
/// </summary>
[ObservableProperty]
private TempModel _selectedItem;

/// <summary>
/// 选中多项
/// </summary>
[ObservableProperty]
private IList _selectedItems;

/// <summary>
/// 双击列表
/// </summary> 
[RelayCommand]
public void DoubleClick(TempModel param)
{
    AduMessageBox.Show($"Double Click {param.Int1} - {param.String1}");
}
/// <summary>
/// 获取选中的多行
/// </summary>
[RelayCommand]
public void GetSelectedItems()
{
    AduMessageBox.Show($"SelectedItems Count({SelectedItems?.Count})");
}
/// <summary>
/// 设置选中多行(连续选中3行)
/// </summary>
[RelayCommand]
public void SetSelectedItems()
{
    var selecteds = new List<TempModel>();
    var selectedCount = Math.Min(3, ItemsSource.Count);
    var startIndex = selectedCount == 0 ? 0 : rand.Next(0, ItemsSource.Count - selectedCount + 1);

    for (int i = 0; i < selectedCount; i++)
        selecteds.Add(ItemsSource[startIndex + i]);

    SelectedItems = selecteds;
}
/// <summary>
/// 移除选中多行
/// </summary>
[RelayCommand]
public void RemoveSelectedItems()
{
    if (SelectedItems is List<object> list && list.Count > 0)
    {
        foreach (TempModel item in list.ToList())
            ItemsSource.Remove(item);
    }
}
/// <summary>
/// 获取选中单行
/// </summary>
[RelayCommand]
public void GetSelectedItem()
{
    AduMessageBox.Show($"SelectedItem ({SelectedItem?.String1})");
}
/// <summary>
/// 设置选中单行(随机选中1行)
/// </summary>
[RelayCommand]
public void SetSelectedItem()
{
    SelectedItem = ItemsSource[rand.Next(0, ItemsSource.Count - 1)];
}
/// <summary>
/// 添加单行
/// </summary>
[RelayCommand]
public void AddItem()
{
    ItemsSource.Add(CreateTempModel(ItemsSource.Count + 1));
}
#endregion

#region 示例 4 性能测试
/// <summary>
/// 数据源
/// </summary>
[ObservableProperty]
private ObservableCollection<TempModel> _performanceItems = new ObservableCollection<TempModel>();
/// <summary>
/// 线程状态
/// </summary>
private CancellationTokenSource? cancellationTokenSource;
/// <summary>
/// 最大行
/// </summary>
[ObservableProperty]
private int _maxRow = 500;
/// <summary>
/// 间隔
/// </summary>
[ObservableProperty]
private int _interval = 100;
/// <summary>
/// 测试
/// </summary>
[ObservableProperty]
private bool _isTestFlight;
partial void OnIsTestFlightChanged(bool oldValue, bool newValue)
{
    if (newValue)
    {
        cancellationTokenSource?.Cancel();
        cancellationTokenSource = new CancellationTokenSource();
        int index = 0;
        Task.Run(async () =>
        {
            while (!cancellationTokenSource.IsCancellationRequested)
            {
                await Application.Current.Dispatcher.InvokeAsync(() =>
                {
                    if (PerformanceItems.Count > MaxRow)
                        PerformanceItems.RemoveAt(0);
                    PerformanceItems.Add(new TempModel()
                    {
                        Int1 = index,
                        String1 = $"追求极致{PerformanceItems.Count}",
                        String2 = $"永臻完美{PerformanceItems.Count}",
                        String3 = $"AduSkin{PerformanceItems.Count}",
                        SelectedItem = SubItems.FirstOrDefault(),
                        SelectedItems = new ObservableCollection<TempModel> { SubItems.FirstOrDefault(), SubItems.LastOrDefault() },
                        Int3 = rand.Next(0, 100),
                        Int2 = rand.Next(-999, 999),
                        Double1 = rand.NextDouble(),
                        Boolean1 = true,
                        Boolean2 = false,
                        Boolean3 = true,
                        DateTime1 = DateTime.Now,
                    });
                    index += 1;
                });
                await Task.Delay(Interval);
            }
        });
    }
    else
        cancellationTokenSource?.Cancel();
}
#endregion 

#region 示例 5 批量复制粘贴单元格
/// <summary>
/// 复制列表
/// </summary>
[ObservableProperty]
private ObservableCollection<TempModel> _items1 = new ObservableCollection<TempModel>();
/// <summary>
/// 粘贴列表
/// </summary>
[ObservableProperty]
private ObservableCollection<TempModel> _items2 = new ObservableCollection<TempModel>();
/// <summary>
/// 键盘操作
/// </summary>
[RelayCommand]
private void PreviewKeyDown(KeyEventArgs e)
{
    if (e.Key == Key.V && (Keyboard.Modifiers & ModifierKeys.Control) == ModifierKeys.Control)
    {
        DataGridExtend.PasteToGrid(e.Source as DataGrid);
        e.Handled = true;
    }
    else if (e.Key == Key.C && (Keyboard.Modifiers & ModifierKeys.Control) == ModifierKeys.Control)
    {
        DataGridExtend.CopySelectedCells(e.Source as DataGrid);
        e.Handled = true;
    }
}
#endregion

