<!-- TreeComboBox Usage Examples -->

<!-- Example 1: Basic Tree ComboBox with hierarchical data -->
<AduSkin:AduTreeComboBox
    Height="32"
    DisplayPath="Name"
    ChildrenPath="Children"
    ItemsSource="{Binding TreeItemsSource}"
    SelectedNode="{Binding SelectedNode}"
    IsShowFullPath="True"
    TreeMaxHeight="300" />

<!-- Example 2: Tree ComboBox showing only node text (not full path) -->
<AduSkin:AduTreeComboBox
    Height="32"
    DisplayPath="Name"
    ChildrenPath="Children"
    ItemsSource="{Binding TreeItemsSource}"
    SelectedNode="{Binding SelectedNode}"
    IsShowFullPath="False"
    TreeMaxHeight="300" />

<!-- Example 3: Disabled Tree ComboBox -->
<AduSkin:AduTreeComboBox
    Height="32"
    DisplayPath="Name"
    ChildrenPath="Children"
    ItemsSource="{Binding TreeItemsSource}"
    SelectedNode="{Binding SelectedNode}"
    IsEnabled="False" />

<!-- Example 4: Tree ComboBox with custom path separator -->
<AduSkin:AduTreeComboBox
    Height="32"
    DisplayPath="Name"
    ChildrenPath="Children"
    ItemsSource="{Binding TreeItemsSource}"
    SelectedNode="{Binding SelectedNode}"
    PathSeparator=" > "
    TreeMaxHeight="300" />

