public WaterfallFlowViewModel()
{
    Random random = new Random();
    for (int i = 0; i < 30; i++)
    {
        ItemsSource.Add(new Tuple<int, string>(random.Next(60, 200), $"{i + 1}"));
    }
}

[ObservableProperty]
private ObservableCollection<Tuple<int, string>> _itemsSource = new ObservableCollection<Tuple<int, string>>();