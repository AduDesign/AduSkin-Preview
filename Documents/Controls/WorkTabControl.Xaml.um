<StackPanel Margin="0,10" Orientation="Horizontal">
    <AduSkin:AduSwitch x:Name="allowAddition" Content="IsAllowAddition" />
    <AduSkin:AduSwitch
        x:Name="allowClose"
        Margin="6,0"
        Content="IsAllowClose" />
</StackPanel>
<AduSkin:AduWorkTabControl
    AddTabCommand="{Binding AddTabCommand}"
    IsAllowAddition="{Binding ElementName=allowAddition, Path=IsChecked}"
    IsAllowClose="{Binding ElementName=allowClose, Path=IsChecked, Mode=TwoWay}"
    ItemsSource="{Binding ItemsSource}"
    SelectedItem="{Binding SelectedItem}">
    <AduSkin:AduWorkTabControl.ItemContainerStyle>
        <Style BasedOn="{StaticResource AduWorkTabItem}" TargetType="{x:Type AduSkin:AduWorkTabItem}">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="CloseTabCommand" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=AduSkin:AduWorkTabControl}, Path=DataContext.CloseTabCommand}" />
            <Setter Property="CloseTabCommandParameter" Value="{Binding}" />
        </Style>
    </AduSkin:AduWorkTabControl.ItemContainerStyle>
    <AduSkin:AduWorkTabControl.ContentTemplate>
        <DataTemplate>
            <ContentControl Content="{Binding}" />
        </DataTemplate>
    </AduSkin:AduWorkTabControl.ContentTemplate>
</AduSkin:AduWorkTabControl>