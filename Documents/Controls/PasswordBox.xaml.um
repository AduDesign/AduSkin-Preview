<!--  Example 1: AduPasswordBox - Show Password  -->
<Border
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<StackPanel>
		<TextBlock
			Margin="0,0,0,15"
			FontSize="18"
			FontWeight="SemiBold"
			Text="Example 1: AduPasswordBox - Password Visible" />

		<TextBlock
			Margin="0,0,0,15"
			FontSize="12"
			Text="AduPasswordBox with password visibility toggle enabled"
			TextWrapping="Wrap" />

		<AduSkin:AduFormBox Header="Password Input">
			<AduSkin:AduPasswordBox Password="{Binding TempPasswrd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</AduSkin:AduFormBox>
	</StackPanel>
</Border>

<!--  Example 2: AduPasswordBox - Hide Password  -->
<Border
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<StackPanel>
		<TextBlock
			Margin="0,0,0,15"
			FontSize="18"
			FontWeight="SemiBold"
			Text="Example 2: AduPasswordBox - Password Hidden" />

		<TextBlock
			Margin="0,0,0,15"
			FontSize="12"
			Text="AduPasswordBox with password visibility toggle disabled"
			TextWrapping="Wrap" />

		<AduSkin:AduFormBox Header="Password Input (No Visibility Toggle)">
			<AduSkin:AduPasswordBox IsCanSeePassword="False" Password="{Binding TempPasswrd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</AduSkin:AduFormBox>
	</StackPanel>
</Border>

<!--  Example 3: Standard PasswordBox with Extension  -->
<Border
	Margin="0,0,0,20"
	BorderThickness="1"
	CornerRadius="8">
	<StackPanel>
		<TextBlock
			Margin="0,0,0,15"
			FontSize="18"
			FontWeight="SemiBold"
			Text="Example 3: Standard PasswordBox with Extension" />

		<TextBlock
			Margin="0,0,0,15"
			FontSize="12"
			Text="Using PasswordExtend to enable binding on standard WPF PasswordBox"
			TextWrapping="Wrap" />

		<UniformGrid Columns="2">
			<AduSkin:AduFormBox Margin="0,0,5,0" Header="Standard PasswordBox (LTR)">
				<PasswordBox AduSkin:PasswordExtend.Password="{Binding TempPasswrd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			</AduSkin:AduFormBox>
			<AduSkin:AduFormBox Margin="5,0,0,0" Header="Standard PasswordBox (RTL)">
				<PasswordBox AduSkin:PasswordExtend.Password="{Binding TempPasswrd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft" />
			</AduSkin:AduFormBox>
		</UniformGrid>
	</StackPanel>
</Border>